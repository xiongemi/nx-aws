    "@aws-sdk/lib-storage": "3.931.0",
    "@smithy/property-provider": "4.2.5",
    "@swc/helpers": "~0.5.12",
    "dotenv": "16.4.7",
    "tar": "7.4.3"
  },
  "devDependencies": {
    "@actions/core": "1.10.1",
    "@actions/github": "6.0.0",
    "@aws-sdk/util-stream-node": "latest",
    "@nx/devkit": "22.0.3",
    "@nx/eslint-plugin": "22.0.3",
    "@nx/jest": "22.0.3",
    "@nx/js": "22.0.3",
    "@nx/plugin": "22.0.3",
    "@nx/workspace": "22.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "^22.10.0",
    "@types/tar": "6.1.13",
    "@typescript-eslint/eslint-plugin": "~8.46.4",
    "@typescript-eslint/parser": "~8.46.4",
    "aws-sdk-client-mock": "^4.0.1",
    "eslint": "~9.39.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-import": "~2.32.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-util": "30.2.0",
    "jsonc-eslint-parser": "^2.4.1",
    "nx": "22.0.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "tslib": "2.3.1",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.5.1"
